# Copie para .env e preencha. Nunca versione o .env.
# Os valores estão vazios para impedir o uso acidental de senhas de exemplo.
# Em produção, valores ausentes, placeholders REPLACE_WITH_* e ADMIN_PASSWORD
# com menos de 12 caracteres impedem a aplicação de iniciar.

# Banco no Docker Compose (serviço "db")
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Host da aplicação no Compose (rede interna): host "db", porta 5432
# Para Prisma/psql fora do container, use 127.0.0.1:5433 (porta publicada só em 127.0.0.1)
# Se a senha/URL tiver caracteres especiais (@ : / # ? etc.), codifique-os na URL
# (ex.: @ → %40, : → %3A). Verifique com um gerador de URL de banco.
# Exemplo de formato: postgresql://USUARIO:SENHA@db:5432/NOME_DA_DB?sslmode=disable
DATABASE_URL=""

# Senha do painel /admin (mínimo 12 caracteres, exclusiva de produção)
ADMIN_PASSWORD=""

# Token de leitura e gravação de um Blob store PRIVADO da Vercel.
# Necessário também fora da Vercel para testar o upload.
BLOB_READ_WRITE_TOKEN=""

# Proxy reverso: defina TRUST_PROXY="1" apenas quando um proxy confiável
# (Caddy/Nginx/Traefik da hospedagem) sempre sobrescrever X-Forwarded-For.
# Sem isso, o rate limit usa uma chave compartilhada e não confia em IP do cliente.
# TRUST_PROXY="1"

NODE_ENV="production"
