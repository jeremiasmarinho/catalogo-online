# Copie para .env e preencha. Nunca versione o .env.
# Os valores abaixo são placeholders e não funcionam como estão.

# Banco no Docker Compose (serviço "db")
POSTGRES_USER="REPLACE_WITH_UNIQUE_USER"
POSTGRES_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_SECRET"
POSTGRES_DB="REPLACE_WITH_DB_NAME"

# Host da aplicação no Compose (rede interna): host "db", porta 5432
# Para Prisma/psql fora do container, use 127.0.0.1:5433 (porta publicada só em local)
DATABASE_URL="postgresql://REPLACE_WITH_UNIQUE_USER:REPLACE_WITH_A_LONG_UNIQUE_SECRET@db:5432/REPLACE_WITH_DB_NAME?sslmode=disable"

# Senha do painel /admin (mínimo 12 caracteres, exclusiva de produção)
ADMIN_PASSWORD="REPLACE_WITH_LONG_UNIQUE_ADMIN_PASSWORD"

NODE_ENV="production"
